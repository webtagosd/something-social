---
import Base from '../layouts/Base.astro';

const BOOK_URL =
  'https://bookings.nowbookit.com/?accountid=7495847b-a417-4dac-83f9-466a2767b993&venueid=1959&theme=light&colors=hex,171343,ed6cd6&font=Montserrat';

const rituals = [
  { day: 'Monday', deal: '$20 pastas', note: 'Buy any drink, we sling you a pasta.' },
  { day: 'Tuesday', deal: '$25 steak night', note: '200g steak, salad and fries.' },
  { day: 'Wednesday', deal: '2 Margheritas, $40', note: 'Dine-in only. Bring a mate.' },
  { day: 'Thursday', deal: '$15 cocktails', note: 'The whole social cocktail list.' },
  { day: 'Friday', deal: '$15 spritz', note: 'Limoncello to tequila. Sun optional.' },
  { day: 'Mon – Fri, 3 – 5pm', deal: 'Social Hour', note: '$10 tap beers, house wines, mimosas and prosecco.' },
];

const reviews = [
  {
    name: 'Irene Lizardo',
    quote:
      'Celebrated my son’s 29th birthday at the rooftop. Very happy with our order and their service. Social platter was massive, and the mocktails did not disappoint. 5 star rating overall for food, service and experience.',
  },
  {
    name: 'Yebin Lee',
    quote:
      'Visited on busy Friday night, yet the service was epic. Zero confusion, no rushing, everyone nice and kind. Perfect suggestions on food and very attentive. Nice and cozy atmosphere, nice bar.',
  },
  {
    name: 'Jonivie',
    quote:
      'Thank you so much for accommodating our last minute booking for 16 people on a Sunday lunch. Service was topnotch and food was incredibly delicious. Highly recommended and will definitely be coming back.',
  },
];
---

<Base
  title="Something & Social Broadway | Rooftop Restaurant & Cocktail Bar, Newmarket"
  description="Newmarket's rooftop restaurant and cocktail bar on Level 3, Westfield Newmarket. Wood-fired pizza, fresh pasta, social cocktails and five spaces with free venue hire."
>
  <main>
    <!-- HERO (sticky, next section climbs over) -->
    <section class="sticky top-0 h-svh w-full overflow-hidden">
      <img
        src="/images/terrace-umbrellas.jpg"
        alt="The Something & Social rooftop terrace under orange umbrellas, full of people"
        class="absolute inset-0 h-full w-full object-cover"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/25 to-ink/40"></div>
      <div class="relative mx-auto flex h-full w-full max-w-[1600px] flex-col justify-end px-5 pb-16 md:px-10 md:pb-20">
        <p class="kicker text-white-warm/80" data-load-fade>Rooftop · Level 3, Westfield Newmarket</p>
        <h1 class="display mt-5 max-w-5xl text-6xl text-white-warm md:text-8xl lg:text-9xl">
          <span data-load-word>Perched</span>
          <span data-load-word>above</span>
          <span data-load-word>Broadway.</span>
        </h1>
        <div class="mt-8 flex max-w-3xl flex-col gap-8 md:mt-10 md:flex-row md:items-end md:justify-between" data-load-fade>
          <p class="max-w-sm leading-relaxed text-white-warm/85">
            Newmarket's rooftop restaurant and cocktail bar. Wood-fired pizza, fresh pasta and long afternoons in the sun.
          </p>
          <div class="flex shrink-0 gap-4">
            <a href={BOOK_URL} target="_blank" rel="noopener" class="btn btn-pink">Book a table</a>
            <a href="/menu" class="btn btn-outline-light">The menus</a>
          </div>
        </div>
      </div>
    </section>

    <!-- MARQUEE (climbs over hero) -->
    <section class="relative z-10 overflow-hidden bg-ink py-4 text-pink-bright" aria-label="Weekly deals">
      <div class="marquee-track gap-0">
        {[0, 1].map(() => (
          <div class="flex shrink-0 items-center" aria-hidden="true">
            {rituals.slice(0, 5).map((r) => (
              <span class="kicker flex items-center whitespace-nowrap px-6">
                {r.day} · {r.deal} <span class="ml-12 text-orange">✺</span>
              </span>
            ))}
            <span class="kicker flex items-center whitespace-nowrap px-6">
              Social Hour · Mon – Fri, 3 – 5pm <span class="ml-12 text-orange">✺</span>
            </span>
          </div>
        ))}
      </div>
    </section>

    <!-- INTRO -->
    <section class="relative z-10 bg-paper">
      <div class="mx-auto max-w-[1600px] px-5 py-24 md:px-10 md:py-36">
        <div class="grid gap-16 lg:grid-cols-12">
          <div class="reveal lg:col-span-5">
            <p class="kicker text-pink">The social hub</p>
            <h2 class="display mt-6 text-5xl md:text-6xl">One level above the rush.</h2>
            <p class="mt-8 max-w-md leading-relaxed text-ink/75">
              An open kitchen, a garden courtyard and a terrace with views down Broadway to the sea. Brunch till 3pm
              every day, dinner under the lights, and a cocktail list that takes its job seriously.
            </p>
            <p class="mt-4 max-w-md leading-relaxed text-ink/75">
              Bring the crew, bring the kids, bring the office. We keep the good times fed.
            </p>
            <dl class="mt-12 grid grid-cols-3 gap-6 border-t border-line pt-8">
              <div>
                <dt class="kicker text-ink/45">Capacity</dt>
                <dd class="display mt-2 text-3xl">250</dd>
              </div>
              <div>
                <dt class="kicker text-ink/45">Spaces</dt>
                <dd class="display mt-2 text-3xl">Five</dd>
              </div>
              <div>
                <dt class="kicker text-ink/45">Venue hire</dt>
                <dd class="display mt-2 text-3xl">Free</dd>
              </div>
            </dl>
          </div>
          <div class="grid gap-6 sm:grid-cols-2 lg:col-span-7">
            <figure class="reveal-img reveal sm:mt-16">
              <img src="/images/interior-dining.jpg" alt="The dining room in full swing under the timber ceiling" class="aspect-[4/5] w-full object-cover" loading="lazy" />
            </figure>
            <figure class="reveal-img reveal">
              <img src="/images/cocktails-tray.jpg" alt="A tray of cocktails carried across the terrace" class="aspect-[4/5] w-full object-cover" loading="lazy" />
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- MANIFESTO (pinned) -->
    <section class="relative z-10 flex h-svh items-center bg-ink text-white-warm" data-manifesto>
      <div class="mx-auto w-full max-w-[1600px] px-5 md:px-10">
        <p class="kicker text-pink-bright" data-manifesto-line>The deal is simple</p>
        <p class="display mt-8 text-5xl md:text-7xl lg:text-8xl" data-manifesto-line>You do the something.</p>
        <p class="display mt-4 text-5xl text-pink-bright md:text-7xl lg:text-8xl" data-manifesto-line>
          We'll do the social.
        </p>
        <p class="mt-10 max-w-md leading-relaxed text-white-warm/60" data-manifesto-line>
          Birthdays. Long lunches. Wednesday for no reason. Whatever you're up to, the kitchen and the bar have your back.
        </p>
      </div>
    </section>

    <!-- FOOD -->
    <section class="relative z-10 bg-paper">
      <div class="mx-auto max-w-[1600px] px-5 py-24 md:px-10 md:py-36">
        <div class="reveal flex flex-wrap items-end justify-between gap-8">
          <div>
            <p class="kicker text-pink">Social eats</p>
            <h2 class="display mt-6 text-5xl md:text-6xl">Made for the middle<br />of the table.</h2>
          </div>
          <a href="/menu" class="btn btn-ink">View the menus</a>
        </div>

        <div class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
          {
            [
              {
                img: 'pizza-overhead.jpg',
                alt: 'Wood-fired pizza fresh from the oven',
                title: 'Pizza',
                copy: 'Napoli-style, gluten-free bases on request. Two Margheritas for $40 on Wednesdays.',
              },
              {
                img: 'food-arancini.jpg',
                alt: 'Porcini arancini with black truffle mayo',
                title: 'Sharing',
                copy: 'Arancini, meatballs, calamari, carpaccio. Or the $85 Social Platter and no decisions at all.',
              },
              {
                img: 'food-parmigiana.jpg',
                alt: 'Chicken parmigiana with fries and salad',
                title: 'Staples',
                copy: 'Parmigiana, 350g ribeye, buttermilk fried chicken burger. The classics, done properly.',
              },
              {
                img: 'spritz-tower.jpg',
                alt: 'A tower of Aperol spritz at the bar',
                title: 'The bar',
                copy: 'Social cocktails, six kinds of spritz, and $70 cocktail trees for the table.',
              },
            ].map((c) => (
              <article class="reveal group">
                <figure class="reveal-img overflow-hidden">
                  <img src={`/images/${c.img}`} alt={c.alt} class="aspect-[3/4] w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
                </figure>
                <h3 class="display mt-6 text-2xl">{c.title}</h3>
                <p class="mt-3 leading-relaxed text-ink/70">{c.copy}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- RITUALS -->
    <section class="relative z-10 bg-cream">
      <div class="mx-auto max-w-[1600px] px-5 py-24 md:px-10 md:py-36">
        <div class="reveal max-w-2xl">
          <p class="kicker text-pink">Social rituals</p>
          <h2 class="display mt-6 text-5xl md:text-6xl">Every day earns its ritual.</h2>
        </div>
        <div class="reveal-stagger mt-16 grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
          {
            rituals.map((r) => (
              <div class="group bg-paper p-8 transition-colors duration-500 hover:bg-ink lg:p-10">
                <p class="kicker text-pink transition-colors group-hover:text-pink-bright">{r.day}</p>
                <p class="display mt-4 text-3xl transition-colors group-hover:text-white-warm md:text-4xl">{r.deal}</p>
                <p class="mt-3 leading-relaxed text-ink/65 transition-colors group-hover:text-white-warm/70">{r.note}</p>
              </div>
            ))
          }
        </div>
        <p class="reveal mt-10 text-ink/60">
          Plus brunch every day till 3pm, kids under 12 eat free on Sundays, and a free dessert for the birthday star.
          <a href="/whats-on" class="text-pink underline underline-offset-4 transition hover:text-ink">See what's on</a>
        </p>
      </div>
    </section>

    <!-- SPACES -->
    <section class="relative z-10 grid bg-ink text-white-warm lg:grid-cols-2">
      <figure class="relative h-80 overflow-hidden lg:h-auto">
        <img
          src="/images/long-table.jpg"
          alt="A long table of guests under the orange umbrellas on the terrace"
          class="absolute inset-0 h-full w-full object-cover"
          data-parallax
          loading="lazy"
        />
      </figure>
      <div class="flex flex-col justify-center px-5 py-24 md:px-16 md:py-36">
        <p class="kicker reveal text-pink-bright">Celebrate &amp; social</p>
        <h2 class="display reveal mt-6 text-5xl md:text-6xl">Five spaces.<br />Zero hire fee.</h2>
        <p class="reveal mt-8 max-w-md leading-relaxed text-white-warm/70">
          The whole rooftop, or one corner of it. An open-kitchen restaurant, a green courtyard, and a terrace with
          views down Broadway to the sea. Birthdays, work dos, engagements, Christmas.
        </p>
        <ul class="reveal-stagger mt-10 max-w-md divide-y divide-line-dark">
          {
            [
              ['Restaurant & Lounge', 'Standing 120 · Seated 80'],
              ['Rooftop Terrace', 'Standing 120'],
              ['Courtyard', 'Standing 30 · Seated 30'],
              ['Full venue', 'Up to 250 guests'],
            ].map(([name, cap]) => (
              <li class="flex items-baseline justify-between gap-6 py-4">
                <span class="display text-xl">{name}</span>
                <span class="kicker text-white-warm/50">{cap}</span>
              </li>
            ))
          }
        </ul>
        <a href="/functions" class="btn btn-pink reveal mt-12 self-start">Plan your function</a>
      </div>
    </section>

    <!-- REVIEWS -->
    <section class="relative z-10 bg-paper">
      <div class="mx-auto max-w-[1600px] px-5 py-24 md:px-10 md:py-36">
        <div class="reveal">
          <p class="kicker text-pink">Kind words</p>
          <h2 class="display mt-6 text-5xl md:text-6xl">The socializers' buzz.</h2>
        </div>
        <div class="reveal-stagger mt-16 grid gap-12 md:grid-cols-3">
          {
            reviews.map((r) => (
              <blockquote class="flex flex-col justify-between gap-8 border-t border-line pt-8">
                <p class="display-italic text-xl leading-snug text-ink/85">“{r.quote}”</p>
                <footer class="kicker text-ink/50">{r.name} · Google review</footer>
              </blockquote>
            ))
          }
        </div>
      </div>
    </section>

    <!-- BOOKING -->
    <section class="relative z-10 bg-blush">
      <div class="mx-auto flex max-w-[1600px] flex-col items-center px-5 py-28 text-center md:py-40">
        <h2 class="display reveal text-6xl md:text-8xl">Pull up a chair.</h2>
        <a href={BOOK_URL} target="_blank" rel="noopener" class="btn btn-ink reveal mt-12">Book your table</a>
        <p class="reveal mt-8 text-sm text-ink/60">
          Groups of 8 or more, call <a href="tel:+6492185085" class="underline underline-offset-4">09 218 5085</a> and
          we'll sort you out.
        </p>
      </div>
    </section>
  </main>
</Base>
