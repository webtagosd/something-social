---

<Base
  title={content.seo.menu.title}
  description="Wood-fired pizza, fresh pasta, sharing plates, social cocktails and spritz on the rooftop of Westfield Newmarket. Brunch till 3pm every day."
>
  <main>
    <!-- HERO -->
    <section class="relative flex min-h-[70svh] items-end overflow-hidden">
      <img
        src="/images/pizza-hands.jpg"
        alt="Pizzas passed across the table"
        class="absolute inset-0 h-full w-full object-cover"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/30 to-ink/40"></div>
      <div class="relative mx-auto w-full max-w-[1600px] px-5 pb-16 md:px-10 md:pb-20">
        <p class="kicker text-white-warm/80" data-load-fade>Ready to feast</p>
        <h1 class="display mt-5 text-6xl text-white-warm md:text-8xl">
          <span data-load-word>Social</span>
          <span data-load-word>eats.</span>
        </h1>
        <div class="mt-8 flex flex-wrap gap-4" data-load-fade>
          <a href="#food" class="btn btn-pink">Food menu</a>
          <a href="#drinks" class="btn btn-outline-light">Drinks menu</a>
        </div>
      </div>
    </section>

    <!-- FOOD -->
    <section id="food" class="relative z-10 bg-paper scroll-mt-20">
      <div class="mx-auto max-w-[1600px] px-5 py-24 md:px-10 md:py-32">
        <div class="reveal max-w-2xl">
          <p class="kicker text-pink">Food</p>
          <h2 class="display mt-6 text-5xl md:text-6xl">From the open kitchen.</h2>
          <p class="mt-6 leading-relaxed text-ink/70">
            Italian at heart, made for sharing. Gluten-free options across the menu, just tell your server about any
            allergies before ordering.
          </p>
        </div>

        <div class="mt-16 grid gap-x-16 gap-y-20 lg:grid-cols-2">
          {
            food.map((s) => (
              <div class="reveal">
                <p class="kicker text-pink">{s.kicker}</p>
                <h3 class="display mt-3 text-3xl md:text-4xl">{s.title}</h3>
                {s.note && <p class="display-italic mt-3 text-ink/60">{s.note}</p>}
                <ul class="mt-8 divide-y divide-line">
                  {s.items.map((i) => (
                    <li class="flex items-baseline justify-between gap-6 py-3.5">
                      <div>
                        <p class="font-medium">{i.name}</p>
                        {i.desc && <p class="mt-0.5 text-sm leading-relaxed text-ink/60">{i.desc}</p>}
                      </div>
                      <p class="display shrink-0 text-lg">{i.price}</p>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- IMAGE BREAK -->
    <section class="relative z-10 grid grid-cols-2 gap-0 md:grid-cols-4">
      {
        ['food-crocchette.jpg', 'pizza-overhead.jpg', 'food-plated.jpg', 'sharing-platter.jpg'].map((img) => (
          <figure class="reveal-img reveal">
            <img src={`/images/${img}`} alt="Dishes from the Something & Social kitchen" class="aspect-square w-full object-cover" loading="lazy" />
          </figure>
        ))
      }
    </section>

    <!-- DRINKS -->
    <section id="drinks" class="relative z-10 bg-ink text-white-warm scroll-mt-20">
      <div class="mx-auto max-w-[1600px] px-5 py-24 md:px-10 md:py-32">
        <div class="reveal max-w-2xl">
          <p class="kicker text-pink-bright">Drinks</p>
          <h2 class="display mt-6 text-5xl md:text-6xl">From the bar.</h2>
          <p class="mt-6 leading-relaxed text-white-warm/70">
            Social Hour runs Monday to Friday, 3 till 5pm. $10 tap beers, house wines, raspberry mimosas and prosecco.
          </p>
        </div>

        <div class="mt-16 grid gap-x-16 gap-y-20 lg:grid-cols-2">
          {
            drinks.map((s) => (
              <div class="reveal">
                <p class="kicker text-pink-bright">{s.kicker}</p>
                <h3 class="display mt-3 text-3xl md:text-4xl">{s.title}</h3>
                <ul class="mt-8 divide-y divide-line-dark">
                  {s.items.map((i) => (
                    <li class="flex items-baseline justify-between gap-6 py-3.5">
                      <div>
                        <p class="font-medium">{i.name}</p>
                        {i.desc && <p class="mt-0.5 text-sm leading-relaxed text-white-warm/55">{i.desc}</p>}
                      </div>
                      <p class="display shrink-0 text-lg">{i.price}</p>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <div class="reveal mt-20 flex flex-col items-start gap-6 border-t border-line-dark pt-10 md:flex-row md:items-center md:justify-between">
          <p class="max-w-xl leading-relaxed text-white-warm/70">
            The full designed menus, every wine and tap pour included. Download them below.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/menus/food-menu.pdf" target="_blank" rel="noopener" class="btn btn-pink">Food menu PDF</a>
            <a href="/menus/drinks-menu.pdf" target="_blank" rel="noopener" class="btn btn-outline-light">Drinks menu PDF</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>
